; ZX Spectrum 48K Emulator configuration file
; Copy this file to config.ini next to the zxem binary
; and edit the paths to match your system.
;
; Precedence: CLI flags > this INI > compiled defaults.
; `zxem --keymap spectrum --config this.ini` keeps spectrum even if
; [input] keymap = wasd below. --config may appear anywhere on argv.

[emulator]
; Path to the .z80 snapshot to load on startup.
; Quote the value if it contains # or ; (those start comments when unquoted):
;   game = "/mnt/games/Foo #1/bar.z80"
game = /tmp/reverse/Manic_Miner_1983_Bug_Byte_Software.z80

; Machine model to emulate. Currently only 'spectrum48' is supported.
; Future options may include: spectrum128, plus2, plus2a, plus3.
model = spectrum48

[rom]
; Path to a real 16KB Spectrum 48K ROM image.
; If this is set, it takes priority over rom_dir.
; Leave empty or comment out to use rom_dir or the synthetic ROM.
; file = /tmp/zx-roms/spectrum16-48/spec48.rom

; Directory to scan for a ROM if 'file' is not set.
; The emulator looks for known filenames (48.rom, spectrum.rom, etc.)
; or any 16384-byte file in this directory.
; If no ROM is found, a legally clean synthetic ROM is generated.
rom_dir = rom

[hardware]
; 48K ULA issue for port FE bits 5 and 7 (default 3).
; Issue 2: bits 5/7 are the inverse of MIC (bit 3 of the last OUT FE).
; Issue 3 and 128K/+3: bits 5/7 always 1.
; issue = 3

[input]
; Optional: set SDL joystick index (0 = first joystick)
; joystick_index = 0

[video]
; Window scale factor (1-4)
; scale = 3

[audio]
; Master volume as a percentage (0-100)
; volume = 100
