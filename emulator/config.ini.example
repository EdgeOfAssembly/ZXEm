; ZX Spectrum emulator configuration
; Copy to config.ini next to the zxem binary and edit.
;
; Precedence: CLI flags > this INI > compiled defaults.
; `zxem --keymap spectrum --config this.ini` keeps spectrum even if
; [input] keymap = wasd below. --config may appear anywhere on argv.

[emulator]
; Path to a snapshot or tape you own. Quote if the value contains # or ; :
;   game = "Foo #1/bar.z80"
; game = game.z80

; spectrum48 (default), spectrum128, or plus3
model = spectrum48

[rom]
; 16KB Spectrum 48K ROM image you own (not shipped).
; file = 48.rom

; Directory to scan if 'file' is not set (48.rom, spectrum.rom, or any 16384-byte file).
; If none is found, a synthetic ROM is generated.
rom_dir = rom

[hardware]
; 48K ULA issue for port FE bits 5 and 7 (default 3).
; Issue 2: bits 5/7 are the inverse of MIC (bit 3 of the last OUT FE).
; Issue 3 and 128K/+3: bits 5/7 always 1.
; issue = 3

[input]
; Optional: set SDL joystick index (0 = first joystick)
; joystick_index = 0

[video]
; Window scale factor (1-4)
; scale = 3

[audio]
; Master volume as a percentage (0-100)
; volume = 100
